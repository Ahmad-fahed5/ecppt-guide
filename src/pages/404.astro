---
import BaseLayout from '../layouts/BaseLayout.astro';
import Alert from '../components/ui/Alert.astro';
---

<BaseLayout title="Page not found" description="The requested page could not be found.">
  <section class="hero">
    <div class="hero-eyebrow">
      <span class="prompt-sign">~/</span> ecppt-guide $ <span class="prompt-sign">404</span>
    </div>
    <h1>Page not found</h1>
    <p class="hero-lede">
      The page you are looking for does not exist, or has not been created yet.
    </p>
    <div class="hero-actions">
      <a class="btn btn--primary" href="/">Back to dashboard</a>
      <a class="btn btn--ghost" href="/guides">Browse guides</a>
    </div>
  </section>

  <Alert variant="warning" title="Nothing here">
    If you followed a link from a draft, it may not be live yet.
  </Alert>
</BaseLayout>
